<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>warehouse_robot_llm</name>
  <version>1.0.0</version>
  <description>Deterministic and optional Mistral command interfaces for warehouse Nav2 goals.</description>
  <maintainer email="antonilin17@users.noreply.github.com">Anton Ilin</maintainer>
  <license>NOASSERTION</license>

  <exec_depend>action_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>warehouse_robot_nav</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
